{
  "name": "@qvqw2233/wechat-md",
  "version": "3.9.2",
  "description": "Community build of the md2wechat CLI with a free local renderer (no API key). Installs the matching GitHub Release binary.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLP2333/md2wechat-skill.git"
  },
  "homepage": "https://github.com/LLP2333/md2wechat-skill#readme",
  "bugs": {
    "url": "https://github.com/LLP2333/md2wechat-skill/issues"
  },
  "bin": {
    "md2wechat": "scripts/run.js"
  },
  "scripts": {
    "pack:check": "npm pack --json --dry-run",
    "postinstall": "node scripts/install.js"
  },
  "files": [
    "scripts/install.js",
    "scripts/run.js",
    "skills/md2wechat",
    "platforms/openclaw/md2wechat",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
